# Copy this file to `.env` and set your own values.

# The Flask API requires this key in the 'X-API-Key' header on /predict and /reload.
FRAUD_API_KEY=replace-with-your-own-secret-key

# Where the API listens. Defaults are used if these are omitted.
# 0.0.0.0 = reachable from outside the machine (needed on the EC2).
API_HOST=0.0.0.0
API_PORT=8000
